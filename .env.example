# TMT-BE-V1 API gateway's root URL (its Render URL in production) —
# e.g. https://api-gateway-xxxx.onrender.com — no path suffix, no /api/v1.
# Leave unset in local dev to automatically fall back to the mock adapter —
# see lib/dev/devMode.ts.
NEXT_PUBLIC_API_URL=

# Each microservice's own standalone Render URL (see the gateway's GET
# /health, whose `routes` object lists exactly these) — all optional. When
# set, store/api/baseApi.ts calls that service directly instead of routing
# through NEXT_PUBLIC_API_URL above; any left unset still go through the
# gateway as before. No path suffix — same root-URL shape as the gateway.
NEXT_PUBLIC_USER_SERVICE_URL=
NEXT_PUBLIC_RESTAURANT_SERVICE_URL=
NEXT_PUBLIC_ORDER_SERVICE_URL=
NEXT_PUBLIC_NOTIFICATION_SERVICE_URL=

# Google Maps JS API key, restricted to this app's domains.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Force the dev mock adapter on even when NEXT_PUBLIC_API_URL is set.
# NEXT_PUBLIC_USE_MOCKS=true
