# TMT-BE-V1 API gateway's root URL (its Render URL in production) —
# e.g. https://api-gateway-xxxx.onrender.com — no path suffix, no /api/v1.
# Leave unset in local dev to automatically fall back to the mock adapter —
# see lib/dev/devMode.ts.
NEXT_PUBLIC_API_URL=

# Google Maps JS API key, restricted to this app's domains.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Force the dev mock adapter on even when NEXT_PUBLIC_API_URL is set.
# NEXT_PUBLIC_USE_MOCKS=true
