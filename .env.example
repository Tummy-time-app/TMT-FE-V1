# Backend API base URL (RTK Query baseApi reads this). Leave unset in local
# dev to automatically fall back to the mock adapter — see lib/dev/devMode.ts.
NEXT_PUBLIC_API_URL=

# Supabase (public/client-safe values only — never the service role key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Maps JS API key, restricted to this app's domains.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Force the dev mock adapter on even when NEXT_PUBLIC_API_URL is set.
# NEXT_PUBLIC_USE_MOCKS=true
